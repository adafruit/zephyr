# Enable MPU
CONFIG_ARM_MPU=y

# Enable GPIO
CONFIG_GPIO=y

# Enable UART driver
CONFIG_SERIAL=y

# Enable console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Build UF2 by default, supported by the Adafruit nRF52 Bootloader
CONFIG_BUILD_OUTPUT_UF2=y

# Link at the code partition, above the SoftDevice. Otherwise the image links
# at 0x0, and flashing it overwrites the SoftDevice.
CONFIG_USE_DT_CODE_PARTITION=y
